# Copy this file to .env and fill in ONE of the two options below.

# Which service to use for Claude: "anthropic" or "bedrock"
LLM_PROVIDER=anthropic

# Option 1 - Anthropic API key (from console.anthropic.com)
ANTHROPIC_API_KEY=your-key-here

# Option 2 - Amazon Bedrock API key (set LLM_PROVIDER=bedrock above)
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-key-here
# AWS_REGION=us-east-1
