# Which way to reach Claude:
#   claude_code - your Claude subscription via the Claude Code CLI (no API key; run `claude` once and log in)
#   anthropic   - Anthropic API key (needed to deploy the app for other users)
#   bedrock     - AWS Bedrock API key
LLM_PROVIDER=claude_code

# Only needed when running in Docker with LLM_PROVIDER=claude_code:
# a long-lived subscription login token created with `claude setup-token` (not an API key)
# CLAUDE_CODE_OAUTH_TOKEN=your-token-here

# Only needed if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here

# Only needed if LLM_PROVIDER=bedrock
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-key-here
# AWS_REGION=us-east-1
