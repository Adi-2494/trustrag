# Which way to reach Claude:
#   claude_code - your Claude subscription via the Claude Code CLI (no API key; run `claude` once and log in)
#   anthropic   - Anthropic API key (needed to deploy the app for other users)
#   bedrock     - AWS Bedrock API key
LLM_PROVIDER=claude_code

# Docker + subscription: prefer saving the token from `claude setup-token` in ~/.trustrag/claude_token and
# mounting it as a file (see README) - that keeps it out of `docker inspect`. Setting it here also works:
# CLAUDE_CODE_OAUTH_TOKEN=your-token-here

# Optional: ask for a password before anyone can use the app (recommended if others can reach it)
# APP_PASSWORD=choose-a-long-password

# Optional: risk levels the injection scanner ALWAYS removes (users can add more, never remove these)
# SCAN_EXCLUDED_RISKS=HIGH

# Optional usage limits (defaults shown)
# MAX_CALLS_PER_HOUR=200
# MAX_QUESTIONS_PER_HOUR=30
# MAX_FILES_PER_SESSION=20

# Optional: per-user accounts with private, persistent workspaces (default off; accounts are created with the admin CLI)
# ACCOUNTS_ENABLED=false
# Session lifetime: idle timeout (1-1440 minutes) and absolute maximum (1-720 hours)
# SESSION_IDLE_MINUTES=120
# SESSION_MAX_HOURS=24
# Login throttling (defaults shown; allowed ranges): failures per username (1-100) and per client address (1-1000)
# within the window (1-1440 minutes), and login attempts per second (1-100)
# LOGIN_MAX_FAILURES_PER_USER=5
# LOGIN_MAX_FAILURES_PER_CLIENT=20
# LOGIN_WINDOW_MINUTES=15
# LOGIN_MAX_PER_SECOND=5
# Per-account caps: workspaces (1-1000) and concurrent sessions (1-100)
# MAX_WORKSPACES_PER_ACCOUNT=10
# MAX_SESSIONS_PER_ACCOUNT=10

# Only needed if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here

# Only needed if LLM_PROVIDER=bedrock
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-key-here
# AWS_REGION=us-east-1
