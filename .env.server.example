# Copy to .env.server (git- and docker-ignored) for `docker compose --profile server up`. Placeholders only.
# Only the two server API containers read this file; the UI and the default `api` service never do.
# The passwords here must match the secret files in your secrets directory (see README, server mode):
#   pg_app_password  -> password of the database role trustrag_app (used in DATABASE_URL)
#   redis_auth.conf  -> one line: requirepass <same password as in REDIS_URL>
# Use long random values and URL-encode special characters in the URLs.
DATABASE_URL=postgresql://trustrag_app:change-me-app-password@postgres:5432/trustrag
REDIS_URL=redis://:change-me-redis-password@redis:6379/0
# Accounts are off by default. Uncomment to require sign-in on the server APIs (needed for the multi-host
# integration tests and for `python -m src.accounts create ...`):
# ACCOUNTS_ENABLED=true
