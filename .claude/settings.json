{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make eval-free)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(pre-commit run:*)",
      "Bash(python scripts/check_invisible_chars.py:*)",
      "Bash(python -m eval.run_eval --suite free:*)",
      "Bash(docker build:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose stop:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --list:*)",
      "Read(./.env.example)"
    ],
    "ask": [
      "Bash(make eval)",
      "Bash(python -m eval.run_eval --suite all:*)",
      "Bash(pip install:*)",
      "Bash(pip-compile:*)",
      "Bash(uv:*)",
      "Bash(rm:*)",
      "Edit(./.claude/settings.json)",
      "Edit(./CLAUDE.md)",
      "Edit(./.github/**)",
      "Edit(./requirements.lock)",
      "Edit(./requirements-dev.lock)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git tag:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git clean:*)",
      "Bash(docker compose down -v:*)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(~/.trustrag/**)",
      "Read(/run/secrets/**)"
    ]
  }
}
